# RSI 教育智能体平台 v1 环境配置示例
# 复制为 .env 并填入真实值；所有变量均可被真实环境变量覆盖

# LLM（OpenAI 兼容协议；默认智谱 GLM）
RSI_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
RSI_LLM_API_KEY=在此填入你的智谱 API Key
RSI_LLM_MODEL=glm-4-flash

# 存储（默认项目内 SQLite 文件）
RSI_DB_PATH=./data/rsi.sqlite3

# 单学习者演示模式（v1 本地默认）
RSI_LEARNER_ID=demo_student_001

# 可选本地单用户登录（设置为true时必须提供PBKDF2散列，不能填写明文密码）。
RSI_LOCAL_AUTH_ENABLED=false
RSI_LOCAL_AUTH_PASSWORD_HASH=
RSI_LOCAL_AUTH_SESSION_HOURS=8
# HTTPS部署才设置true；HTTP localhost保持false。
RSI_LOCAL_AUTH_COOKIE_SECURE=false
# 教师/家长视图独立用途口令；仅在忽略的.env.local配置。
RSI_LOCAL_TEACHER_TOKEN=
RSI_LOCAL_PARENT_TOKEN=

# 课程资产来源（空值使用基础12题 + synthetic覆盖层 + 原题库映射）。
# 相对路径从platform目录解析；自定义来源不会自动追加内置覆盖层。
# JSON可为AssetCatalog、生成manifest或SyntheticBundle；CSV为合成课程manifest。
RSI_LEARNING_CATALOG_PATH=
# 多个覆盖文件用JSON字符串数组（Windows路径建议写正斜杠）。
RSI_LEARNING_CATALOG_OVERLAYS=[]

# 可选：透传 chat/completions 私有字段（JSON 串）。推理模型关思考链示例：
# RSI_LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
