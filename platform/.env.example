# 桂子问津 Wenjin V4：开发模板，无真实凭据，禁止提交 .env/.env.local。
# 优先级：进程环境 > .env.local > .env；同一来源 WENJIN_* > legacy RSI_*。
# 旧 RSI_* 继续兼容；不要在同一来源为两个前缀配置冲突值。
# 必需开发配置：Python 3.11；默认 SQLite / FakeLLM 可离线运行。
# 本地服务仅监听 127.0.0.1；禁止将此模板直接用作公网生产配置。
WENJIN_PORT=8000

# LLM（OpenAI 兼容协议；默认智谱 GLM）
WENJIN_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
WENJIN_LLM_API_KEY=
WENJIN_LLM_MODEL=glm-4-flash

# 存储（默认项目内 SQLite 文件）
WENJIN_DB_PATH=./data/rsi.sqlite3

# 单学习者演示模式（v1 本地默认）
WENJIN_LEARNER_ID=demo_student_001

# 可选本地单用户登录（设置为true时必须提供PBKDF2散列，不能填写明文密码）。
WENJIN_LOCAL_AUTH_ENABLED=false
WENJIN_LOCAL_AUTH_PASSWORD_HASH=
WENJIN_LOCAL_AUTH_SESSION_HOURS=8
# HTTPS部署才设置true；HTTP localhost保持false。
WENJIN_LOCAL_AUTH_COOKIE_SECURE=false
# 教师/家长视图独立用途口令；仅在忽略的.env.local配置。
WENJIN_LOCAL_TEACHER_TOKEN=
WENJIN_LOCAL_PARENT_TOKEN=

# 课程资产来源（空值使用基础12题 + synthetic覆盖层 + 原题库映射）。
# 相对路径从platform目录解析；自定义来源不会自动追加内置覆盖层。
# JSON可为AssetCatalog、生成manifest或SyntheticBundle；CSV为合成课程manifest。
WENJIN_LEARNING_CATALOG_PATH=
# 多个覆盖文件用JSON字符串数组（Windows路径建议写正斜杠）。
WENJIN_LEARNING_CATALOG_OVERLAYS=[]

# 可选：透传 chat/completions 私有字段（JSON 串）。推理模型关思考链示例：
# WENJIN_LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
# Server-owned assessment delivery required by default. Disable only for trusted legacy fixtures.
WENJIN_ASSESSMENT_REQUIRE_TICKET=true

# 生产/真实试点前置（本地 MVP 不声称已完成）：TLS、身份/RBAC/SSO、
# 租户隔离、监控、备份/删除、课程审核、同意、Provider 合规和真实校准。
# 真实 Provider 可选；填入 API Key 后将发送学习内容至远程服务，先完成授权。
# 上述显式开发默认关闭登录；共享电脑使用时应开启登录并设置 PBKDF2 hash。
# 教师/家长 token 不是学校级正式身份系统，不应作为公网生产鉴权。
# 修改既有数据库前备份；启动 Store 自动升级版本化 SQLite foundation schema。
