# RSI 教育智能体平台 v1 环境配置示例
# 复制为 .env 并填入真实值；所有变量均可被真实环境变量覆盖

# LLM（OpenAI 兼容协议；默认智谱 GLM）
RSI_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
RSI_LLM_API_KEY=在此填入你的智谱 API Key
RSI_LLM_MODEL=glm-4-flash

# 存储（默认项目内 SQLite 文件）
RSI_DB_PATH=./data/rsi.sqlite3

# 单学习者演示模式（v1 本地默认）
RSI_LEARNER_ID=demo_student_001

# S02 正式账号/空间数据库：运行 scripts/dev_postgres.py 生成 .local/database.env
# RSI_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:55432/wenjin
# 开发数据默认 synthetic；不要把开发题/模拟交互标记为真实学生
RSI_DATA_MODE=synthetic
RSI_COOKIE_SECURE=0
RSI_PORT=4003
RSI_ALLOWED_ORIGINS=http://127.0.0.1:4003,http://localhost:4003

# 可选：透传 chat/completions 私有字段（JSON 串）。推理模型关思考链示例：
# RSI_LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# 新统一 Provider 独立开发探测（独立于旧 RSI_LLM_*）
# WENJIN_PROVIDER=deepseek
# WENJIN_MODEL=deepseek-flash
# WENJIN_PROVIDER_URL=https://api.deepseek.com
# WENJIN_PROVIDER_TIMEOUT=30
# 密钥优先通过 python -m app.llm.probe 隐藏交互输入；勿提交真实密钥。

# 概率练习模型任务：由管理端发布配置，不因存在密钥而自动启用。
# python -m app.manage set-model-key 将密钥写入忽略的 .local/deepseek.key。
# 服务部署也可通过环境注入 WENJIN_DEEPSEEK_KEY（勿写入此示例）。
# WENJIN_DEEPSEEK_KEY_FILE=.local/deepseek.key
