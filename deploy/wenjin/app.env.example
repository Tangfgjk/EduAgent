# Copy to /etc/guiziwenjin/app.env; do not commit real secrets.
DEEPTUTOR_HOME=/opt/guiziwenjin
DEEPTUTOR_IGNORE_PROCESS_ENV_OVERRIDES=0
NODE_ENV=production
PYTHONUNBUFFERED=1
PYTHONUTF8=1
BACKEND_PORT=8001
FRONTEND_PORT=3782
DEEPTUTOR_API_BASE_URL=http://127.0.0.1:8001
AUTH_ENABLED=true
NEXT_PUBLIC_AUTH_ENABLED=true
DEEPTUTOR_AUTH_ENABLED=true
# Use false ONLY for private HTTP acceptance; set true before HTTPS public launch.
AUTH_COOKIE_SECURE=true
# Use the approved domain only. Change here if guiziwenjin.ccnu.edu.cn is approved instead.
CORS_ORIGINS=https://wenjin.ccnu.edu.cn
