# HTTP acceptance on the public IP, as explicitly requested.
# Set AUTH_COOKIE_SECURE=true together with HTTPS before a formal launch.
DEEPTUTOR_HOME=/opt/guiziwenjin
DEEPTUTOR_IGNORE_PROCESS_ENV_OVERRIDES=0
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=512
PYTHONUNBUFFERED=1
PYTHONUTF8=1
BACKEND_PORT=8001
FRONTEND_PORT=3782
DEEPTUTOR_API_BASE_URL=http://127.0.0.1:8001
AUTH_ENABLED=true
NEXT_PUBLIC_AUTH_ENABLED=true
DEEPTUTOR_AUTH_ENABLED=true
AUTH_COOKIE_SECURE=false
AUTH_PRIVATE_LOGIN_HOSTS=47.111.38.174:8088,127.0.0.1,localhost
AUTH_TRUSTED_FRONTEND_PROXY_IPS=127.0.0.1,::1
CORS_ORIGINS=http://47.111.38.174:8088
DEEPTUTOR_VERSION_CHECK_ENABLED=false
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
